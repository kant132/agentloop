{
  "route": {
    "description": "HTTP routing annotations (entry points)",
    "patterns": [
      "org.springframework.web.bind.annotation.GetMapping",
      "org.springframework.web.bind.annotation.PostMapping",
      "org.springframework.web.bind.annotation.PutMapping",
      "org.springframework.web.bind.annotation.DeleteMapping",
      "org.springframework.web.bind.annotation.PatchMapping",
      "org.springframework.web.bind.annotation.RequestMapping",
      "jakarta.ws.rs.GET",
      "jakarta.ws.rs.POST",
      "jakarta.ws.rs.PUT",
      "jakarta.ws.rs.DELETE",
      "jakarta.ws.rs.PATCH",
      "javax.ws.rs.GET",
      "javax.ws.rs.POST",
      "javax.ws.rs.PUT",
      "javax.ws.rs.DELETE",
      "javax.ws.rs.PATCH",
      "io.micronaut.http.annotation.Get",
      "io.micronaut.http.annotation.Post",
      "io.micronaut.http.annotation.Put",
      "io.micronaut.http.annotation.Delete",
      "io.micronaut.http.annotation.Patch",
      "org.apache.dubbo.config.annotation.DubboService",
      "com.alibaba.dubbo.config.annotation.Service"
    ]
  },
  "auth": {
    "description": "Authentication/Authorization annotations",
    "patterns": [
      "org.springframework.security.access.prepost.PreAuthorize",
      "org.springframework.security.access.annotation.Secured",
      "jakarta.annotation.security.RolesAllowed",
      "javax.annotation.security.RolesAllowed",
      "org.apache.shiro.authz.annotation.RequiresAuthentication",
      "org.apache.shiro.authz.annotation.RequiresPermissions"
    ]
  },
  "validation": {
    "description": "Input validation annotations",
    "patterns": [
      "jakarta.validation.constraints.*",
      "javax.validation.constraints.*",
      "org.hibernate.validator.constraints.*"
    ]
  },
  "ignore": {
    "description": "Annotations to skip during route detection",
    "patterns": [
      "java.lang.Override",
      "java.lang.Deprecated",
      "java.lang.SuppressWarnings",
      "org.junit.Test",
      "org.junit.jupiter.api.Test",
      "org.springframework.stereotype.Component",
      "org.springframework.stereotype.Service",
      "org.springframework.stereotype.Repository"
    ]
  }
}