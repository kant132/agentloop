    {
      "id": "sink-sql-jdbc-statement",
      "category": "injection.sql",
      "cwe_id": "CWE-89",
      "owasp": "A03:2021 Injection",
      "fqns": [
        "java.sql.Statement.executeQuery",
        "java.sql.Statement.execute",
        "java.sql.Statement.executeUpdate",
        "java.sql.Statement.executeBatch",
        "java.sql.Statement.addBatch"
      ],
      "description": "JDBC Statement 直接执行 SQL,字符串已拼接/含用户输入即 SQLi",
      "severity": "high",
      "confidence": "high",
      "dangerous_args": [0],
      "notes": "如果 SQL 完全硬编码且不含用户输入,通常为低风险;若 SQL 含变量拼接则为高风险"
    },
    {
      "id": "sink-sql-jdbc-preparestatement-concat",
      "category": "injection.sql",
      "cwe_id": "CWE-89",
      "owasp": "A03:2021 Injection",
      "fqns": [
        "java.sql.Connection.prepareStatement"
      ],
      "description": "PreparedStatement 但 SQL 已拼接(占位符未用)= 实际 SQLi",
      "severity": "high",
      "confidence": "high",
      "dangerous_args": [0],
      "notes": "看到 PreparedStatement 不等于安全(per 预置经验规则.md §1.2);必须验证 SQL 字符串是否含占位符 ?"
    },
