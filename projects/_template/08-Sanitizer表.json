        "org.owasp.encoder.Encode.forJavaScript",
        "org.owasp.encoder.Encode.forUriComponent"
      ],
      "description": "OWASP Java Encoder - 按上下文细分的转义(forHtml/forJavaScript/forUriComponent 等)",
      "effectiveness": "strong",
      "confidence": "high",
      "applies_to_sinks": ["sink-xss-servlet-writer"]
    },
    {
      "id": "san-xss-thymeleaf-th-text",
      "category": "xss",
      "cwe_id": "CWE-79",
      "fqns": [],
      "description": "Thymeleaf th:text 默认 HTML 转义;th:utext 关闭转义",
      "effectiveness": "strong",
      "confidence": "high",
      "applies_to_sinks": ["sink-xss-thymeleaf-utext"],
      "required_conditions": [
        "必须是 th:text 而非 th:utext"
      ]
    },
    {
      "id": "san-xxe-disallow-doctype",
      "category": "xxe",
      "cwe_id": "CWE-611",
      "fqns": [
        "javax.xml.parsers.DocumentBuilderFactory.setFeature",
        "javax.xml.parsers.SAXParserFactory.setFeature",
        "javax.xml.transform.TransformerFactory.setFeature"
      ],
      "description": "XML 解析器安全配置 - setFeature('http://apache.org/xml/features/disallow-doctype-decl', true) + 禁用外部实体",
      "effectiveness": "strong",
      "confidence": "high",
      "applies_to_sinks": ["sink-xxe-documentbuilder"],
      "required_conditions": [
        "必须 4 个 setFeature 都设置:disallow-doctype-decl + external-general-entities + external-parameter-entities + load-external-dtd",
        "必须 setXIncludeAware(false)",
        "必须 setExpandEntityReferences(false)",
        "必须在 parse() 之前调用"
      ]
    },
    {
      "id": "san-path-filenameutils-getname",
      "category": "path_traversal",
      "cwe_id": "CWE-22",
      "fqns": [
        "org.apache.commons.io.FilenameUtils.getName",
        "org.apache.commons.io.FilenameUtils.getBaseName"
      ],
      "description": "FilenameUtils.getName - 取最后一段,移除路径前缀",
      "effectiveness": "medium",
      "confidence": "medium",
      "applies_to_sinks": ["sink-path-file-constructor", "sink-path-paths"],
      "required_conditions": [
        "必须配合 getCanonicalPath + 前缀校验防止符号链接绕过"
      ],
      "common_failure_modes": [
        "未做规范化和前缀校验,symlink 可绕过"
      ]
    },
    {
      "id": "san-path-canonical-prefix-check",
      "category": "path_traversal",
      "cwe_id": "CWE-22",
      "fqns": [
        "java.io.File.getCanonicalPath",
        "java.nio.file.Path.toRealPath",
        "java.nio.file.Path.normalize"
      ],
      "description": "getCanonicalPath/normalize + 前缀校验 - 标准化后比对 baseDir 前缀",
      "effectiveness": "strong",
      "confidence": "high",
      "applies_to_sinks": ["sink-path-file-constructor", "sink-path-paths"],
      "required_conditions": [
        "必须 toRealPath 或 getCanonicalPath(解析符号链接)",
        "必须 startsWith(baseDir.getCanonicalPath() + File.separator),而不是简单的 startsWith"
      ]
    },
    {
