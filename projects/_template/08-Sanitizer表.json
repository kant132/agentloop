        "org.springframework.web.util.HtmlUtils.htmlEscape"
      ],
      "description": "Spring HtmlUtils.htmlEscape - HTML 上下文转义",
      "effectiveness": "strong",
      "confidence": "high",
      "applies_to_sinks": ["sink-xss-servlet-writer"],
      "required_conditions": [
        "必须在 write/println 之前调用",
        "仅适用于 HTML 上下文;JS/URL/属性上下文需其他消毒"
      ]
    },
    {
