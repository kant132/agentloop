      ],
      "description": "Apache Commons escapeHtml4 - HTML 上下文转义",
      "effectiveness": "strong",
      "confidence": "high",
      "applies_to_sinks": ["sink-xss-servlet-writer"],
      "required_conditions": [
        "必须在 write 之前调用"
      ],
      "notes": "commons-lang3 3.6 后 StringEscapeUtils 已 deprecated,推荐 commons-text"
    },
    {
      "id": "san-xss-owasp-encoder",
