{
  "$schema": "sanitizer-catalog",
  "version": "1.0",
  "description": "通用 Java 消毒器清单 - 标记这些模式时不视为漏洞(高置信),但仍需审计调用顺序",
  "maintained_in": "projects/_template/06-通用安全知识.md §2",
  "sources": [
    "OWASP ASVS 4.0 §5 (Validation, Sanitization, Encoding)",
    "OWASP CheatSheet Series",
    "Spring Security Reference",
    "Jakarta Bean Validation 3.0",
    "Apache Commons Documentation"
  ],
  "warning": "看到消毒器 ≠ 安全(per requirements/预置经验规则.md §1.2)。必须验证:1) 消毒器真的被调用 2) 调用顺序在 sink 之前 3) 消毒器真的有效(参数完整、未被包装绕过)",
  "sanitizers": [
    {
      "id": "san-sql-preparedstatement-setstring",
      "category": "sql",
      "cwe_id": "CWE-89",
      "fqns": [
        "java.sql.PreparedStatement.setString",
        "java.sql.PreparedStatement.setInt",
        "java.sql.PreparedStatement.setLong",
        "java.sql.PreparedStatement.setDouble",
        "java.sql.PreparedStatement.setFloat",
        "java.sql.PreparedStatement.setBoolean",
        "java.sql.PreparedStatement.setObject",
        "java.sql.PreparedStatement.setNull",
        "java.sql.PreparedStatement.setTimestamp",
        "java.sql.PreparedStatement.setDate",
        "java.sql.PreparedStatement.setBytes"
      ],
      "description": "PreparedStatement 参数绑定,SQL 含 ? 占位符且 setXxx 调用 = 强消毒",
      "effectiveness": "strong",
      "confidence": "high",
      "applies_to_sinks": ["sink-sql-jdbc-statement", "sink-sql-jdbc-preparestatement-concat"],
      "required_conditions": [
        "SQL 字符串必须含 ? 占位符",
        "setXxx 的 index 与 ? 位置一一对应",
        "setXxx 必须在 executeQuery/execute 之前调用",
        "SQL 字符串本身不能含拼接(必须纯字面量 + ?)"
      ],
      "common_failure_modes": [
        "SQL 已拼接后 prepareStatement(无效)",
        "setXxx index 错位",
        "setXxx 未调用就 execute"
      ]
    },
    {
      "id": "san-sql-jdbctemplate-varargs",
      "category": "sql",
      "cwe_id": "CWE-89",
      "fqns": [
        "org.springframework.jdbc.core.JdbcTemplate.query",
        "org.springframework.jdbc.core.JdbcTemplate.update"
      ],
      "description": "JdbcTemplate.query(sql, Object[] args, RowMapper) - args 数组自动参数化",
      "effectiveness": "strong",
      "confidence": "high",
      "applies_to_sinks": ["sink-sql-jdbctemplate"],
      "required_conditions": [
        "第二个参数必须是 Object[] 数组",
        "SQL 字符串含 ? 占位符",
        "args 数组元素顺序与 ? 一致"
      ],
      "common_failure_modes": [
        "query(sql, args, rowMapper) 但 args 只有一个元素 - 仍可能拼接"
      ]
    },
    {
      "id": "san-sql-namedparamjdbctemplate",
      "category": "sql",
      "cwe_id": "CWE-89",
      "fqns": [
        "org.springframework.jdbc.core.NamedParameterJdbcTemplate.query",
        "org.springframework.jdbc.core.NamedParameterJdbcTemplate.update"
      ],
      "description": "NamedParameterJdbcTemplate - :name 占位 + SqlParameterSource/Map 参数 = 强消毒",
      "effectiveness": "strong",
      "confidence": "high",
      "applies_to_sinks": ["sink-sql-jdbctemplate"],
      "required_conditions": [
        "SQL 含 :name 占位符",
        "第二参数是 Map<String,?> 或 SqlParameterSource",
        "Map keys 覆盖所有 :name"
      ]
    },
    {
      "id": "san-sql-jpa-setparameter",
      "category": "sql",
      "cwe_id": "CWE-89",
      "fqns": [
        "javax.persistence.Query.setParameter",
        "jakarta.persistence.Query.setParameter",
        "javax.persistence.TypedQuery.setParameter",
        "org.hibernate.query.Query.setParameter"
      ],
      "description": "JPA/Hibernate setParameter - :name/?N 占位 + 参数对象 = 强消毒",
      "effectiveness": "strong",
      "confidence": "high",
      "applies_to_sinks": ["sink-sql-jpa-native"],
      "required_conditions": [
        "createQuery/createNativeQuery 字符串已用占位符",
        "setParameter 在 execute 之前调用",
        "createQuery 的 SQL 字符串本身不能含拼接"
      ]
    },
    {
      "id": "san-sql-mybatis-hash-placeholder",
      "category": "sql",
      "cwe_id": "CWE-89",
      "fqns": [],
      "description": "MyBatis XML/注解中 #{} 占位符 = 强消毒;${} 字符串替换 = 无效消毒",
      "effectiveness": "strong",
      "confidence": "high",
      "applies_to_sinks": ["sink-sql-mybatis-provider"],
      "required_conditions": [
        "XML mapper 或 @Select 注解中必须用 #{} 而非 ${}",
        "Provider 方法体内也必须用 #{}"
      ],
      "common_failure_modes": [
        "order by ${column} - 故意用 ${} 注入列名 = 应 SQL 注入审计"
      ]
    },
    {
      "id": "san-xss-htmlutils",
