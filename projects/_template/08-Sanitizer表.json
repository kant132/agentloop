      "confidence": "high",
      "applies_to_sinks": ["*"],
      "required_conditions": [
        "必须白名单(允许的字符集),不是黑名单",
        "正则必须锚定 ^...$ 或全匹配模式"
      ],
      "common_failure_modes": [
        "黑名单正则易绕过",
        "正则缺失锚定"
      ]
    },
    {
      "id": "san-input-bean-validation-pattern",
      "category": "input_validation",
      "cwe_id": "CWE-20",
      "fqns": [
        "jakarta.validation.constraints.Pattern",
