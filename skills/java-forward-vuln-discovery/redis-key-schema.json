{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Redis Key Schema for forward vuln discovery",
  "description": "FWD-X subagent 读写 Redis 的 key 设计。",
  "version": 1,
  "namespaces": {
    "project": "audit:{groupId}:commit:{commitHash}:*",
    "global": "audit:global:*"
  },
  "keys": {
    "method_body": {
      "pattern": "audit:{groupId}:commit:{commitHash}:method:{fqn}#{sigHash}",
      "ttl_seconds": 86400,
      "value_schema": {
        "fqn": "string",
        "sig_hash": "string",
        "body": "string",
        "file": "string",
        "line": "integer",
        "class": "string",
        "depth": "integer",
        "sha256": "string"
      },
      "writer": "redis-batch-prefetch.py",
      "reader": "FWD-X subagent"
    },
    "prefetch_summary": {
      "pattern": "audit:{groupId}:commit:{commitHash}:prefetch:{chainId}",
      "ttl_seconds": 3600,
      "value_schema": {
        "chain_id": "string",
        "group_id": "string",
        "commit": "string",
        "methods": [
          {"fqn": "string", "sig_hash": "string", "key": "string"}
        ]
      },
      "writer": "redis-batch-prefetch.py",
      "reader": "FWD-X subagent 启动时"
    },
    "chain_summary": {
      "pattern": "audit:{groupId}:commit:{commitHash}:chain:{chainId}",
      "ttl_seconds": 3600,
      "value_schema": {
        "chain_id": "string",
        "endpoint_fqn": "string",
        "depth": "integer",
        "node_count": "integer"
      }
    },
    "judgment": {
      "pattern": "audit:{groupId}:commit:{commitHash}:judgment:{fqn}#{D-id}",
      "ttl_seconds": 3600,
      "value_schema": {
        "D-id": "string",
        "result": "string",
        "evidence": "string"
      }
    },
    "astmatch": {
      "pattern": "audit:{groupId}:commit:{commitHash}:astmatch:{fqn}#{patternId}",
      "ttl_seconds": 86400,
      "value_schema": {
        "matched": "boolean",
        "pattern_id": "string",
        "match_location": "string"
      }
    },
    "finding_draft": {
      "pattern": "audit:{groupId}:commit:{commitHash}:finding:{chainId}:draft",
      "ttl_seconds": 2592000,
      "value_schema": {
        "ref": "finding-schema.json"
      },
      "writer": "FWD-X subagent"
    },
    "finding_final": {
      "pattern": "audit:{groupId}:commit:{commitHash}:finding:{chainId}:final",
      "ttl_seconds": null,
      "value_schema": {
        "ref": "finding-schema.json"
      },
      "writer": "finding-promoter.py (3x85 后)"
    },
    "score": {
      "pattern": "audit:{groupId}:commit:{commitHash}:score:{chainId}:r{roundN}",
      "ttl_seconds": null,
      "value_schema": {"type": "integer", "minimum": 0, "maximum": 100},
      "writer": "REFLECT subagent",
      "reader": "finding-promoter.py"
    },
    "env_reachability": {
      "pattern": "audit:{groupId}:commit:{commitHash}:env:reachability",
      "ttl_seconds": 3600,
      "value_schema": {
        "ssh": "reachable | unreachable | degraded",
        "http": "reachable | unreachable | degraded",
        "last_check": "ISO8601",
        "checker": "string"
      }
    },
    "subagent_killed": {
      "pattern": "audit:{groupId}:commit:{commitHash}:subagent-killed:{subagent_id}",
      "ttl_seconds": 604800,
      "value_schema": {
        "killed_at": "ISO8601",
        "completed_chains": ["string"],
        "remaining": ["string"]
      }
    }
  }
}
